@page "{id:int}"
@model TodoApp.Pages.Projects.DetailsModel
@{
    ViewData["Title"] = Model.Project?.Name ?? "Project";
}

<a class="breadcrumb-link" asp-page="/Index">&larr; All Projects</a>
<h1 class="page-title">@Model.Project?.Name</h1>

<h2 class="section-title">Tasks</h2>

@if (Model.TaskCount > 0)
{
    var percent = Model.DoneTaskCount * 100 / Model.TaskCount;
    <div class="progress-summary">
        <div class="progress-track">
            <div class="progress-fill" style="width:@(percent)%"></div>
        </div>
        <span class="progress-label">@Model.DoneTaskCount / @Model.TaskCount done</span>
    </div>
}

<form method="post" asp-page-handler="AddTask" class="add-form">
    <input type="text" asp-for="NewTaskName" placeholder="New task name" />
    <button type="submit" class="btn-add">+ Add Task</button>
</form>

@if (Model.TaskCount == 0)
{
    <p class="empty-state">No tasks yet &mdash; break this project down by adding one above.</p>
}

<form method="post" asp-page-handler="ReorderTasks" id="reorder-tasks-form">
    <input type="hidden" name="orderedIds" id="reorder-tasks-input" />
</form>

<ol class="quest-list" id="tasks-list">
    @foreach (var task in Model.Tasks)
    {
        var locked = Model.IsLocked(task);
        var hasSubtasks = Model.HasSubtasks(task);
        <li class="quest-card @(locked ? "is-locked" : "") @(task.IsDone ? "is-done" : "")" draggable="true" data-id="@task.Id">
            <span class="drag-handle">&#10021;</span>
            <span class="order-pill">@task.Order</span>

            @if (locked)
            {
                <input type="checkbox" checked="@task.IsDone" disabled title="Locked &mdash; finish the previous task first" />
            }
            else if (!hasSubtasks)
            {
                <form method="post" asp-page-handler="ToggleTask">
                    <input type="hidden" name="taskId" value="@task.Id" />
                    <input type="checkbox" onchange="this.form.submit()" checked="@task.IsDone" />
                </form>
            }
            else
            {
                <input type="checkbox" checked="@task.IsDone" disabled title="Auto-completes when all Subtasks are done" />
            }

            <div class="quest-main">
                @if (locked)
                {
                    <span class="quest-title is-locked">@task.Name</span>
                    <span class="badge-status locked">Locked</span>
                }
                else
                {
                    <a class="quest-title @(task.IsDone ? "is-done" : "")" asp-page="/Tasks/Details" asp-route-id="@task.Id">@task.Name</a>
                    @if (task.IsDone)
                    {
                        <span class="badge-status done">Done</span>
                    }
                    else if (hasSubtasks)
                    {
                        <span class="badge-status auto">Auto</span>
                    }
                    else
                    {
                        <span class="badge-status active">In progress</span>
                    }
                }
            </div>

            <button type="button" class="btn-rename" onclick="toggleInline(this)">+ Subtask</button>
            <form method="post" asp-page-handler="AddSubtaskToTask" class="rename-form" style="display:none">
                <input type="hidden" name="taskId" value="@task.Id" />
                <input type="text" name="name" placeholder="New subtask name" />
                <button type="submit" class="btn-rename">Add</button>
            </form>

            <button type="button" class="btn-rename" onclick="toggleInline(this)">Rename</button>
            <form method="post" asp-page-handler="RenameTask" class="rename-form" style="display:none">
                <input type="hidden" name="taskId" value="@task.Id" />
                <input type="text" name="name" value="@task.Name" />
                <button type="submit" class="btn-rename">Save</button>
            </form>

            <form method="post" asp-page-handler="DeleteTask"
                  onsubmit="return confirm('Delete this task and everything under it?')">
                <input type="hidden" name="taskId" value="@task.Id" />
                <button type="submit" class="btn-delete">Delete</button>
            </form>
        </li>
    }
</ol>

@section Scripts {
    <script>
        initDragReorder('tasks-list', 'reorder-tasks-form', 'reorder-tasks-input');
    </script>
}
