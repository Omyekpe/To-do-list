@page "{id:int}"
@model TodoApp.Pages.Subtasks.DetailsModel
@{
    ViewData["Title"] = Model.Subtask?.Name ?? "Subtask";
}

<a class="breadcrumb-link" asp-page="/Tasks/Details" asp-route-id="@Model.Subtask?.TaskId">&larr; Back to Task</a>
<h1 class="page-title">@Model.Subtask?.Name</h1>

<h2 class="section-title">Steps</h2>

@if (Model.StepCount > 0)
{
    var percent = Model.DoneStepCount * 100 / Model.StepCount;
    <div class="progress-summary">
        <div class="progress-track">
            <div class="progress-fill" style="width:@(percent)%"></div>
        </div>
        <span class="progress-label">@Model.DoneStepCount / @Model.StepCount done</span>
    </div>
}

<form method="post" asp-page-handler="AddStep" class="add-form">
    <input type="text" asp-for="NewStepName" placeholder="New step name" />
    <button type="submit" class="btn-add">+ Add Step</button>
</form>

@if (Model.StepCount == 0)
{
    <p class="empty-state">No steps yet &mdash; break this subtask down by adding one above.</p>
}

<form method="post" asp-page-handler="ReorderSteps" id="reorder-steps-form">
    <input type="hidden" name="orderedIds" id="reorder-steps-input" />
</form>

<ol class="quest-list" id="steps-list">
    @foreach (var step in Model.Steps)
    {
        var locked = Model.IsLocked(step);
        <li class="quest-card @(locked ? "is-locked" : "") @(step.IsDone ? "is-done" : "")" draggable="true" data-id="@step.Id">
            <span class="drag-handle">&#10021;</span>
            <span class="order-pill">@step.Order</span>

            @if (locked)
            {
                <input type="checkbox" disabled />
                <div class="quest-main">
                    <span class="quest-title is-locked">@step.Name</span>
                    <span class="badge-status locked">Locked</span>
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="ToggleStep">
                    <input type="hidden" name="stepId" value="@step.Id" />
                    <input type="checkbox" onchange="this.form.submit()" checked="@step.IsDone" />
                </form>
                <div class="quest-main">
                    <span class="quest-title @(step.IsDone ? "is-done" : "")">@step.Name</span>
                    @if (step.IsDone)
                    {
                        <span class="badge-status done">Done</span>
                    }
                    else
                    {
                        <span class="badge-status active">In progress</span>
                    }
                </div>
            }

            <button type="button" class="btn-rename" onclick="toggleRename(this)">Rename</button>
            <form method="post" asp-page-handler="RenameStep" class="rename-form" style="display:none">
                <input type="hidden" name="stepId" value="@step.Id" />
                <input type="text" name="name" value="@step.Name" />
                <button type="submit" class="btn-rename">Save</button>
            </form>

            <form method="post" asp-page-handler="DeleteStep"
                  onsubmit="return confirm('Delete this step?')">
                <input type="hidden" name="stepId" value="@step.Id" />
                <button type="submit" class="btn-delete">Delete</button>
            </form>
        </li>
    }
</ol>

@section Scripts {
    <script>
        initDragReorder('steps-list', 'reorder-steps-form', 'reorder-steps-input');
    </script>
}
