@page
@model IndexModel
@{
    ViewData["Title"] = "Projects";
}

<h1>Projects</h1>

<form method="post">
    <input type="text" asp-for="NewProjectName" placeholder="New project name" />
    <button type="submit">Add Project</button>
</form>

<ul>
    @foreach (var project in Model.Projects)
    {
        <li>
            <a asp-page="/Projects/Details" asp-route-id="@project.Id">@project.Name</a>

            <form method="post" asp-page-handler="RenameProject" style="display:inline">
                <input type="hidden" name="projectId" value="@project.Id" />
                <input type="text" name="name" value="@project.Name" />
                <button type="submit">Rename</button>
            </form>

            <form method="post" asp-page-handler="DeleteProject" style="display:inline"
                  onsubmit="return confirm('Delete this project and everything under it?')">
                <input type="hidden" name="projectId" value="@project.Id" />
                <button type="submit">Delete</button>
            </form>
        </li>
    }
</ul>
